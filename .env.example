# Pi Go 配置
# 复制为 .env 并填入真实值。

# ===== LLM Provider =====
# 可选：mock / anthropic / openai
PI_GO_PROVIDER=anthropic

# ===== Anthropic 格式 =====
# https://api.longcat.chat/anthropic 兼容 Anthropic Messages API
ANTHROPIC_API_KEY=ak_1hb78c5hG3Oe7IQ1VM1nj58T2o373
ANTHROPIC_MODEL=LongCat-Flash-Chat
ANTHROPIC_BASE_URL=https://api.longcat.chat/anthropic

# ===== OpenAI 格式 =====
# https://api.longcat.chat/openai 兼容 OpenAI Chat Completions API
OPENAI_API_KEY=ak_1hb78c5hG3Oe7IQ1VM1nj58T2o373
OPENAI_MODEL=LongCat-Flash-Chat
OPENAI_BASE_URL=https://api.longcat.chat/openai

# ===== Server =====
PI_GO_HOST=127.0.0.1
PI_GO_PORT=8080
PI_GO_SESSION_FILE=./data/session.jsonl

# ===== Tool sandbox =====
PI_GO_WORKSPACE=/tmp/pi-go-workspace
PI_GO_ENABLE_BASH=false
PI_GO_BASH_TIMEOUT_SECONDS=30
