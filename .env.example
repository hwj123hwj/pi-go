# Pi Go 配置
# 复制为 .env 并填入真实值。

# ===== LLM Provider =====
# 可选：anthropic / openai
PI_GO_PROVIDER=openai

# ===== OpenAI 格式（本地网关）=====
PI_GO_API_KEY=sk-xxxx
PI_GO_MODEL=longcat-opus
PI_GO_BASE_URL=http://localhost:4001

# ===== Anthropic 格式（可选）=====
# ANTHROPIC_API_KEY=your-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===== Server =====
PI_GO_HOST=127.0.0.1
PI_GO_PORT=8080
PI_GO_SESSION_FILE=./data/session.jsonl

# ===== Tool sandbox =====
PI_GO_WORKSPACE=/tmp/pi-go-workspace
PI_GO_ENABLE_BASH=false
PI_GO_BASH_TIMEOUT_SECONDS=30

# ===== Feishu bridge (optional) =====
# FEISHU_APP_ID=cli_xxxxx
# FEISHU_APP_SECRET=xxxxx
# Optional for manual credentials; QR setup saves this automatically.
# FEISHU_OWNER_OPEN_ID=ou_xxxxx
# PI_AGENT_URL=http://127.0.0.1:8080
