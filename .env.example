# Pi Go 本地开发配置

# 说明：
# 1. 复制本文件为 .env.local，填入真实值。
# 2. 不要提交 .env.local；里面会包含 API Key。
# 3. 当前代码还未读取该文件，后续接入真实 Provider/HTTP 测试时会按这些字段实现。

# ===== LLM Provider =====
# 可选：mock / anthropic / openai
PI_GO_PROVIDER=mock

# ===== Anthropic =====
# 如果后续要优先实现 Claude/Anthropic Provider，请填写：
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===== OpenAI-compatible =====
# 如果后续要实现 OpenAI 或兼容 OpenAI 的服务，请填写：
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Server =====
PI_GO_HOST=127.0.0.1
PI_GO_PORT=8080
PI_GO_SESSION_FILE=./data/session.jsonl

# ===== Tool sandbox / workspace =====
# 建议填一个专门给工具读写/执行命令的目录，避免工具误操作整个仓库。
PI_GO_WORKSPACE=/tmp/pi-go-workspace

# 是否允许 bash 工具执行真实命令。开发阶段建议先填 false，确认安全后再改 true。
PI_GO_ENABLE_BASH=false

# bash 工具单次命令超时秒数。
PI_GO_BASH_TIMEOUT_SECONDS=30
