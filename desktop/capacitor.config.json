{
  "appId": "com.ezycode.pigo",
  "appName": "EasyAgent",
  "webDir": "dist/renderer",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#262624",
      "showSpinner": false
    }
  }
}
