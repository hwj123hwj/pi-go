{
  "name": "pi-go-desktop",
  "version": "0.2.0",
  "description": "Pi-Go Desktop Client - AI Coding Agent GUI",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "electron:build:arm64": "vite build && tsc -p tsconfig.electron.json && electron-builder --arm64",
    "electron:build:x64": "vite build && tsc -p tsconfig.electron.json && electron-builder --x64",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "extends": "electron-builder.yml"
  },
  "dependencies": {
    "@types/semver": "^7.7.1",
    "fuzzysort": "^3.1.0",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semver": "^7.8.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
