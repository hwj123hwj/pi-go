{
  "expo": {
    "name": "Pi-Go",
    "slug": "pigo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "pigo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#262624"
    },
    "android": {
      "package": "com.ezycode.pigo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#262624"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
